{
  "name": "@tonehub/midi-host-android",
  "version": "0.0.0",
  "private": true,
  "description": "Android USB-OTG NativeMidiHost (MidiManager) for CubeControl",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "plugin": "./app.plugin.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "android",
    "app.plugin.js",
    "expo-module.config.json",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "react-native",
    "expo",
    "midi",
    "usb-otg"
  ],
  "dependencies": {
    "@tonehub/midi-transport-native": "workspace:*"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "expo": "~57.0.12",
    "typescript": "~5.9.2"
  }
}
